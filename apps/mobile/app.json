{
  "expo": {
    "name": "PlayVerzus.xyz",
    "slug": "playverzus",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "playverzus",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0C10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.playverzus.app"
    },
    "android": {
      "package": "xyz.playverzus.app"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
