# Playverzus v2.0 Server-Only Environment Variables (NEVER expose to client JS)
# Copy this file to `.env` inside `Playverzus.xyz version 2,0/` and paste your
# live Kopo Kopo credentials (e.g. from your LaserTickets live dashboard).

KOPOKOPO_ENV=live
KOPOKOPO_BASE_URL=https://api.kopokopo.com
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_API_KEY=
KOPOKOPO_TILL_NUMBER=
KOPOKOPO_CALLBACK_URL=https://playverzus-api.onrender.com/api/webhooks/mpesa
