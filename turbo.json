{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "DATABASE_URL",
    "UPSTASH_REDIS_URL",
    "UPSTASH_REDIS_TOKEN",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "R2_PUBLIC_URL",
    "WALLET_MODE",
    "OPTIIC_API_KEY",
    "TWITCH_CLIENT_ID",
    "TWITCH_CLIENT_SECRET",
    "YOUTUBE_API_KEY",
    "ENABLE_STREAM_INGEST",
    "ENABLE_REAL_MONEY",
    "ENABLE_KYC",
    "CROSSMINT_SERVER_API_KEY",
    "NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY",
    "NEXT_PUBLIC_CROSSMINT_ENVIRONMENT",
    "SENTRY_DSN",
    "JWT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
